# Copy this file to `.env` and fill in your key:
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Get a key at: https://console.mistral.ai/  ->  API Keys

MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: pin the OCR model (default is mistral-ocr-4)
# MISTRAL_OCR_MODEL=mistral-ocr-4

# Hosted cross-encoder reranker (§3.5). Any ONE of these enables it.
# Jina has a free tier that covers this corpus comfortably.
JINA_AI_API_KEY=
# COHERE_API_KEY=
# VOYAGE_API_KEY=
